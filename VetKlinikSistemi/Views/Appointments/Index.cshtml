@using VetKlinikSistemi.Models
@model IEnumerable<VetKlinikSistemi.Models.Appointment>
@{
    ViewData["Title"] = "Randevularım";

    string BadgeClass(AppointmentStatus status) => status switch
    {
        AppointmentStatus.Bekliyor => "bg-warning text-dark",
        AppointmentStatus.Onaylandi => "bg-primary",
        AppointmentStatus.Tamamlandi => "bg-success",
        AppointmentStatus.Reddedildi => "bg-danger",
        _ => "bg-secondary"
    };

    string StatusLabel(AppointmentStatus status) => status switch
    {
        AppointmentStatus.Bekliyor => "Bekliyor",
        AppointmentStatus.Onaylandi => "Onaylandı",
        AppointmentStatus.Tamamlandi => "Tamamlandı",
        AppointmentStatus.Reddedildi => "İptal / Reddedildi",
        _ => status.ToString()
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">Randevularım</h2>
        <small class="text-muted">Tüm randevu taleplerinizi, onay durumlarını ve muayene notlarını takip edin.</small>
    </div>
    <a asp-action="Create" class="btn btn-success">+ Yeni Randevu Al</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Tarih & Saat</th>
                    <th>Evcil Hayvan</th>
                    <th>Hizmet</th>
                    <th>Veteriner Hekim</th>
                    <th>Ücret</th>
                    <th>Durum</th>
                    <th>Muayene Notu</th>
                    <th class="text-end">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            Henüz oluşturulmuş bir randevunuz bulunmuyor.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.AppointmentDate.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                <a asp-controller="Pets" asp-action="Details" asp-route-id="@item.PetId" class="text-decoration-none fw-semibold">
                                    @item.Pet?.Name
                                </a>
                            </td>
                            <td>@item.ClinicService?.Name</td>
                            <td>@item.Veterinarian?.FullName</td>
                            <td>@item.Price.ToString("N2") ₺</td>
                            <td><span class="badge @BadgeClass(item.Status)">@StatusLabel(item.Status)</span></td>
                            <td>@(string.IsNullOrWhiteSpace(item.ExaminationNote) ? "-" : item.ExaminationNote)</td>
                            <td class="text-end">
                                @if ((item.Status == AppointmentStatus.Bekliyor || item.Status == AppointmentStatus.Onaylandi) && item.AppointmentDate > DateTime.Now)
                                {
                                    <form asp-action="Cancel" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bu randevuyu iptal etmek istediğinize emin misiniz?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">İptal Et</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
