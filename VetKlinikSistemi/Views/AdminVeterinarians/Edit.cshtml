@model VetKlinikSistemi.DTOs.VeterinarianEditViewModel
@{
    ViewData["Title"] = "Veteriner Hekim Düzenle";
    var services = ViewBag.Services as List<VetKlinikSistemi.Models.ClinicService> ?? new();
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Veteriner Hekim Bilgilerini Düzenle</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Email" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label class="form-label">Kullanıcı E-posta Hesabı</label>
                        <input value="@Model.Email" class="form-control" disabled />
                    </div>
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label">Ad Soyad</label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Specialty" class="form-label">Uzmanlık Alanı</label>
                        <input asp-for="Specialty" class="form-control" />
                        <span asp-validation-for="Specialty" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Verebildiği Hizmetler</label>
                        <div class="border rounded p-2">
                            @foreach (var s in services)
                            {
                                bool isChecked = Model.SelectedServiceIds.Contains(s.Id);
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="SelectedServiceIds" value="@s.Id" id="srv_@s.Id" @(isChecked ? "checked" : "") />
                                    <label class="form-check-label" for="srv_@s.Id">@s.Name (@s.DurationMinutes dk)</label>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">İptal</a>
                        <button type="submit" class="btn btn-primary">Güncelle</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
