@model IEnumerable<VetKlinikSistemi.Models.ClinicService>
@{
    ViewData["Title"] = "Hizmet Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Klinik Hizmetleri</h2>
    <a asp-action="Create" class="btn btn-success">+ Yeni Hizmet Ekle</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Hizmet Adı</th>
                    <th>Açıklama</th>
                    <th>Süre</th>
                    <th>Ücret</th>
                    <th>Hekim Sayısı</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">Henüz tanımlanmış bir hizmet bulunmuyor.</td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.Name</td>
                        <td>@(item.Description ?? "-")</td>
                        <td>@item.DurationMinutes dk</td>
                        <td>@item.Price.ToString("N2") ₺</td>
                        <td><span class="badge bg-info text-dark">@item.Veterinarians.Count Hekim</span></td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bu hizmeti silmek istediğinize emin misiniz?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
