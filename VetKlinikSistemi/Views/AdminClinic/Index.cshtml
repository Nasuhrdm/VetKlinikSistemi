@model VetKlinikSistemi.Models.Clinic
@{
    ViewData["Title"] = "Klinik Bilgileri";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h4 class="mb-0">Klinik Bilgileri ve Çalışma Saatleri</h4>
            </div>
            <div class="card-body">
                <form asp-action="Index" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Klinik Adı</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Address" class="form-label">Adres</label>
                        <input asp-for="Address" class="form-control" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label">Telefon</label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="OpeningTime" class="form-label">Açılış Saati</label>
                            <input asp-for="OpeningTime" type="time" class="form-control" />
                            <span asp-validation-for="OpeningTime" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ClosingTime" class="form-label">Kapanış Saati</label>
                            <input asp-for="ClosingTime" type="time" class="form-control" />
                            <span asp-validation-for="ClosingTime" class="text-danger"></span>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary">Değişiklikleri Kaydet</button>
                </form>
            </div>
        </div>
    </div>
</div>
